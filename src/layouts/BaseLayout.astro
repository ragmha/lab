---
import '../styles/global.css'
import SeoHead from '../components/SeoHead.astro'
import ThemeInit from '../components/ThemeInit.astro'

interface Props {
  title?: string
  description?: string
  bodyClass?: string
  pageClass?: string
  defaultTheme?: 'dark' | 'system'
}

const {
  title,
  description,
  bodyClass,
  pageClass,
  defaultTheme,
} = Astro.props

---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} />
    {defaultTheme && <ThemeInit defaultTheme={defaultTheme} />}
  </head>
  <body class={bodyClass}>
    <div class:list={['page', pageClass]}>
      <slot />
    </div>
  </body>
</html>
