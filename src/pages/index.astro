---
import BaseLayout from '../layouts/BaseLayout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import LabFlask from '../components/LabFlask.astro'
import languageData from '../data/languages.json'
import '../styles/fonts.css'
import '../styles/theme.css'

const totalBytes = languageData.reduce((total, language) => total + language.size, 0)
if (!totalBytes) throw new Error('GitHub language statistics must not be empty')
const languages = languageData.map(({ size, node }) => ({ ...node, percentage: size / totalBytes * 100 }))

const experiments = [
  {
    slug: 'session-flame',
    title: 'Where Did the Time Go?',
    description: 'Replay a coding-agent session as a flame chart: prompts, model turns, tools, and sub-agents, with idle time folded away.',
  },
  {
    slug: 'context-autopsy',
    title: 'What’s Under the Prompt?',
    description: 'See what happens under the hood when you prompt: context growth, cache reuse, model calls, tools, and cost elsewhere.',
  },
  {
    slug: 'token-diet',
    title: 'Does Your Coding Agent Need a Token Diet?',
    description: 'Compare a coding agent’s token use across two rounds of recorded runs, with the reproduction kit and measurements.',
  },
  {
    slug: 'chess',
    title: 'Can a Browser Tab Beat You at Chess?',
    description: 'Play Stockfish compiled to WebAssembly. The engine runs on your device; no moves leave the page.',
  },
]
---

<BaseLayout
  title="Experiments"
  description="Interactive experiments and technical demonstrations by Raghib Hasan."
  bodyClass="lab-surface"
  pageClass="lab-home"
  defaultTheme="dark"
>
  <main class="site-shell home">
    <header class="lab-heading">
      <div class="brand">
      <h1>
        <svg class="wordmark" viewBox="0 0 76 28" width="190" height="70" aria-hidden="true">
          <path fill-rule="evenodd" d="M0 0h4v24h16v4H0z M28 4h4V0h12v4h4v24h-4V16H32v12h-4z M32 4v8h12V4z M56 0h16v4h4v8h-4v4h4v8h-4v4H56z M60 4v8h12V4z M60 16v8h12v-8z" />
        </svg>
        <span>Raghib’s Lab — Experiments</span>
      </h1>
      <LabFlask />
      </div>
      <ThemeToggle />
    </header>

    <section class="languages" aria-labelledby="languages-title">
      <div class="language-heading">
        <h2 id="languages-title">Languages</h2>
        <a href="https://github.com/ragmha/lab">Source bytes on GitHub ↗</a>
      </div>
      <div class="language-bar" aria-hidden="true">
        {languages.map((language) => <span style={{ width: `${language.percentage}%`, background: language.color ?? 'var(--theme-muted)' }} />)}
      </div>
      <ul class="language-legend" role="list">
        {languages.map((language) => (
          <li><span class="language-dot" style={{ background: language.color ?? 'var(--theme-muted)' }} aria-hidden="true" /><span>{language.name} <span class="percentage">{language.percentage.toFixed(1)}%</span></span></li>
        ))}
      </ul>
    </section>

    <ul class="experiment-grid" role="list">
      {experiments.map((experiment, index) => (
        <li>
          <a class="experiment" href={`/${experiment.slug}/`} aria-labelledby={experiment.slug}>
            <span class="panel-label" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{experiment.slug}</span>
            </span>
            <h2 id={experiment.slug}>{experiment.title}</h2>
            <p>{experiment.description}</p>
            <span class="open-label" aria-hidden="true"><span class="prompt">&gt;</span> open experiment <span>↗</span></span>
          </a>
        </li>
      ))}
    </ul>

    <footer>
      <nav aria-label="Lab navigation">
        <a href="https://raghib.io/">[writing]</a>
        <a href="https://github.com/ragmha/lab">[source]</a>
      </nav>
      <span>{experiments.length} experiments</span>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(body.lab-surface) {
    --text: var(--theme-text);
    --body: var(--theme-text);
    --accent: var(--theme-blue);
    background: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    line-height: 1.65;
  }

  :global(.lab-home) {
    width: min(100% - 3rem, 80rem);
    padding-block: clamp(2rem, 7vw, 5rem) 2.5rem;
  }

  .site-shell.home { padding: 0; }

  .lab-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .brand { display: flex; align-items: flex-end; gap: 1rem; }
  h1 { margin: 0; line-height: 1; }
  .wordmark { display: block; fill: currentColor; shape-rendering: crispEdges; }
  h1 span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .lab-heading :global(#theme-toggle) {
    min-width: 6rem;
    min-height: 2.75rem;
    border: 1px solid var(--theme-rule-strong);
    border-radius: 0;
    background: var(--theme-bg);
    color: var(--theme-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .lab-heading :global(#theme-toggle[hidden]) { display: block; visibility: hidden; }
  .lab-heading :global(#theme-toggle:hover) { color: var(--theme-text); border-color: currentColor; }

  .languages { margin: 0 0 2.5rem; }
  .language-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .language-heading h2 { margin: 0; color: var(--theme-text); font-size: 0.85rem; }
  .language-heading a { font-size: 0.7rem; }
  .language-heading a, nav a { color: var(--theme-blue); text-underline-offset: 0.25em; }
  .language-bar { display: flex; height: 0.55rem; margin-top: 1rem; overflow: hidden; }
  .language-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0.75rem 0 0; padding: 0; list-style: none; font-size: 0.75rem; }
  .language-legend li { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
  .language-dot { width: 0.5rem; height: 0.5rem; flex: none; background: var(--theme-muted); }
  .percentage { color: var(--theme-muted); }

  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .experiment-grid li { min-width: 0; margin: 0; }
  .experiment {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--theme-rule-strong);
    color: var(--theme-text);
    text-decoration: none;
  }
  .panel-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: -1.25rem -1.25rem 1.25rem;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid var(--theme-rule-strong);
    color: var(--theme-muted);
    font-size: 0.7rem;
  }
  h2 {
    margin: 0 0 0.75rem;
    color: var(--theme-blue);
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: normal;
    text-wrap: balance;
  }
  .experiment p { margin: 0 0 1.5rem; color: var(--theme-muted); font-size: 0.85rem; }
  .open-label { margin-top: auto; font-size: 0.75rem; }
  .open-label > :last-child { float: right; }
  .prompt { display: inline-block; width: 1.5ch; color: var(--theme-blue); }
  .experiment:hover { border-color: var(--theme-blue); background: var(--theme-surface); }
  .experiment:focus-visible { background: var(--theme-text); color: var(--theme-bg); }
  .experiment:focus-visible :is(h2, p, .panel-label, .prompt) { color: inherit; }
  .experiment:focus-visible .panel-label { border-color: currentColor; }

  footer, nav { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }
  footer { justify-content: space-between; margin-top: 2rem; color: var(--theme-muted); font-size: 0.75rem; }
  nav a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; }
  nav a:hover { text-decoration: underline; }

  @media (max-width: 68rem) {
    .experiment-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 42rem) {
    :global(.lab-home) { width: calc(100% - 2rem); }
    .experiment-grid { grid-template-columns: minmax(0, 1fr); }
    .brand { gap: 0.75rem; }
    .wordmark { width: 114px; height: 42px; }
  }
</style>
