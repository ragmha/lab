<script>
  const root = document.querySelector<HTMLElement>('.cost')!
  const tip = root.querySelector<HTMLElement>('.tip')!
  const tabs = [...root.querySelectorAll<HTMLInputElement>('input[name="tab"]')]

  const select = () => {
    const tab = tabs.find((input) => input.value === location.hash.slice(1))
    if (tab) tab.checked = true
  }
  select()
  addEventListener('hashchange', select)
  root.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement
    if (input.name === 'tab') history.replaceState(null, '', `#${input.value}`)
  })

  // Hovering a colored item dims every item with a different color.
  let marked: string | undefined
  const mark = (key?: string) => {
    if (key === marked) return
    marked = key
    for (const item of root.querySelectorAll<HTMLElement>('[data-k]')) item.classList.toggle('dim', key !== undefined && item.dataset.k !== key)
  }
  const hide = () => {
    tip.hidden = true
    mark()
  }
  const show = (event: PointerEvent) => {
    const target = (event.target as Element).closest<HTMLElement>('[data-tip],[data-k]')
    if (!target) return hide()
    mark(target.dataset.k)
    tip.hidden = !target.dataset.tip
    if (tip.hidden) return
    tip.textContent = target.dataset.tip!
    const { width, height } = tip.getBoundingClientRect()
    const x = Math.min(event.clientX + 14, innerWidth - width - 8)
    const y = event.clientY + 18 + height > innerHeight ? event.clientY - height - 12 : event.clientY + 18
    tip.style.transform = `translate(${Math.max(8, x)}px, ${Math.max(8, y)}px)`
  }
  root.addEventListener('pointermove', show)
  root.addEventListener('pointerdown', show)
  root.addEventListener('pointerleave', hide)
</script>
