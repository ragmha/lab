---
import SiteLayout from '../layouts/SiteLayout.astro'
import data from '../data/token-diet.json'
import roundTwoData from '../data/token-diet-2.json'
import { decode, encode } from 'gpt-tokenizer/encoding/o200k_base'
import { correlation, cost, instructions, kinds, median, medianRun, total } from '../lib/token-diet'
import type { Call, Kind, Run, Tokens } from '../lib/token-diet'

const runs = data.runs as Run[]
const rates = data.rates as Tokens
const number = new Intl.NumberFormat('en-US')
const percent = new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 })
const wholePercent = new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 0 })
const perThousand = new Intl.NumberFormat('en-US', { maximumFractionDigits: 3 })
const thousands = (value: number) => `${Math.round(value / 1000)}k`
const aiu = (nano: number) => (nano / 1e9).toFixed(2)
const signed = (value: number) => `${value < 0 ? '−' : '+'}${number.format(Math.abs(value))}`

const names: Record<Kind, string> = {
  cacheRead: 'Cache read',
  cacheWrite: 'Cache write',
  fresh: 'Fresh input',
  output: 'Output',
}

const setupOptions = [
  { id: 'a', name: 'Baseline' },
  { id: 'b', name: 'Principles' },
  { id: 'c', name: 'caveman' },
  { id: 'd', name: 'rtk' },
  { id: 'e', name: 'All three' },
  { id: 'f', name: 'Token Optimizer' },
]
const setups = setupOptions
  .filter((setup) => runs.some((run) => run.variant === setup.id))
  .map((setup) => {
    const set = runs.filter((run) => run.variant === setup.id)
    const sizes = set.map((run) => total(run.totals))
    const charges = set.map((run) => run.nanoAiu)
    return {
      ...setup,
      set,
      shown: medianRun(set),
      succeeded: set.filter((run) => run.success).length,
      tokens: median(sizes),
      low: Math.min(...sizes),
      high: Math.max(...sizes),
      calls: median(set.map((run) => run.calls.length)),
      aiu: median(charges),
      aiuLow: Math.min(...charges),
      aiuHigh: Math.max(...charges),
      prompt: median(set.map((run) => total(run.calls[0]) - run.calls[0].output)),
      firstAiu: median(set.map((run) => cost(run.calls[0], rates))),
      prose: median(set.map((run) => run.proseChars)),
      proseShare: median(set.map((run) => run.proseChars / (run.proseChars + run.argChars))),
      biggestResult: Math.max(...set.flatMap((run) => run.calls.flatMap((call) => call.tools.map((tool) => tool.outTokens)))),
    }
  })
const setup = (id: string) => {
  const found = setups.find((item) => item.id === id)
  if (!found) throw new Error(`token-diet.json is missing required setup "${id}"`)
  return found
}
const baseline = setup('a')
const principles = setup('b')
const caveman = setup('c')
const rtk = setup('d')
const all = setup('e')
const optimizer = setups.find((item) => item.id === 'f')
const versions = data.versions as Record<string, string>
const after = setups.slice(1)
const versus = (setup: (typeof setups)[number]) => setup.tokens / baseline.tokens - 1
const [closest, furthest] = [after.reduce((a, b) => (versus(a) < versus(b) ? a : b)), after.reduce((a, b) => (versus(a) > versus(b) ? a : b))]
const change = (setup: (typeof setups)[number]) => `${versus(setup) > 0 ? '+' : '−'}${percent.format(Math.abs(versus(setup)))}`

const pooled = Object.fromEntries(kinds.map((kind) => [kind, runs.reduce((sum, run) => sum + run.totals[kind], 0)])) as Tokens
const tokenShare = (kind: Kind) => percent.format(pooled[kind] / total(pooled))
const costShare = (kind: Kind) => percent.format((pooled[kind] * rates[kind]) / cost(pooled, rates))
const callsVsTokens = correlation(runs.map((run) => run.calls.length), runs.map((run) => total(run.totals)))
const lastCall = median(runs.map((run) => total(run.calls[run.calls.length - 1])))
const sharedPrefix = runs[0].calls[0].cacheRead
const testRuns = runs.reduce((sum, run) => sum + run.testRuns, 0)
const unpipedTestRuns = runs.reduce((sum, run) => sum + run.testRunsUnpiped, 0)
const rtkSaved = median(rtk.set.map((run) => run.rtk?.saved ?? 0))
const extraSkills = caveman.set[0].skills - baseline.set[0].skills
const narrowestSpread = Math.min(...setups.map((setup) => setup.high - setup.low))
const widestGap = Math.max(...setups.map((setup) => setup.tokens)) - Math.min(...setups.map((setup) => setup.tokens))
const largest = runs.reduce((max, run) => (total(run.totals) > total(max.totals) ? run : max))
const failed = runs.filter((run) => !run.success)
const beatBaseline = after.filter((setup) => setup.tokens < baseline.tokens)
const mixed = after.find((setup) => setup.tokens < baseline.tokens !== setup.aiu < baseline.aiu)
const side = (value: number, of: number) => (value < of ? 'below' : 'above')
const why = (run: Run) =>
  !run.committed ? 'made no commit'
    : !run.testsPass ? 'left tests failing'
      : 'fixed the bugs but used a commit scope the repository’s guide does not allow'
const nameOf = (run: Run) => setups.find((setup) => setup.id === run.variant)?.name ?? run.variant

// Waterfall: each setup's median run, one row per model call. `axis` sets the replay speed.
const axis = Math.ceil(Math.max(...setups.map((setup) => total(setup.shown.totals))) / 100_000) * 100_000
const callAxis = Math.ceil(Math.max(...setups.flatMap((setup) => setup.shown.calls.map(total))) / 10_000) * 10_000
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`
const what = (call: Call) =>
  call.tools.map((tool) => (tool.name === 'bash' ? tool.label : `${tool.name} ${tool.label}`)).join(' · ') || 'final reply'
const stops = (values: number[]) => {
  const sum = values.reduce((a, b) => a + b, 0)
  let running = 0
  return values.map((value, i) => `--s${i + 1}:${((running += value) / sum).toFixed(4)}`).join(';')
}
const pick = ({ cacheRead, cacheWrite, fresh, output }: Tokens): Tokens => ({ cacheRead, cacheWrite, fresh, output })
const rateList = kinds.map((kind) => `${names[kind].toLowerCase()} ${perThousand.format(rates[kind] / 1e6)}`).join(', ')
const raceJson = JSON.stringify({
  axis,
  rates,
  lanes: Object.fromEntries(setups.map((setup) => [setup.id, setup.shown.calls.map(pick)])),
}).replace(/</g, '\\u003c')

// Tokenizer: the text the agent reads before its first tool call, split by o200k_base.
const split = (name: string, text: string) => {
  const ids = encode(text)
  return { name, text, ids, pieces: ids.map((id) => decode([id])) }
}
const prompt = split('Task prompt', data.prompt)
const readings = [
  { label: 'Baseline', parts: [prompt] },
  { label: 'Principles', parts: [split('Instructions file', instructions(data.principles)), prompt] },
].map((reading) => ({
  ...reading,
  tokens: reading.parts.reduce((sum, part) => sum + part.ids.length, 0),
  characters: reading.parts.reduce((sum, part) => sum + part.text.length, 0),
}))

// Every run: one dot per run on a shared axis.
const stripMax = Math.ceil(total(largest.totals) / 100_000) * 100_000
const stripTicks = [0, 1, 2, 3].map((i) => (stripMax / 3) * i)

const roundTwoRuns = roundTwoData.runs as Run[]
const roundTwoOptions = [
  { id: 'a', name: 'Baseline', method: 'The CLI as installed.' },
  { id: 'b', name: 'Principles', method: 'Six rules in the user instructions file.' },
  { id: 'c', name: 'caveman', method: 'A session-start hook that switches the agent to terse replies, plus its skills.' },
  { id: 'd', name: 'rtk', method: 'An instruction and hook that route commands through rtk to filter their output.' },
  { id: 'e', name: 'All three', method: 'Principles, caveman, and rtk together.' },
  { id: 'f', name: 'Token Optimizer', method: 'The Copilot adapter installed into an isolated home.' },
]
const roundTwoSetups = roundTwoOptions
  .filter((setup) => roundTwoRuns.some((run) => run.variant === setup.id))
  .map((setup) => {
    const set = roundTwoRuns.filter((run) => run.variant === setup.id)
    const sizes = set.map((run) => total(run.totals))
    return {
      ...setup,
      set,
      shown: medianRun(set),
      succeeded: set.filter((run) => run.success).length,
      tokens: median(sizes),
      low: Math.min(...sizes),
      high: Math.max(...sizes),
      calls: median(set.map((run) => run.calls.length)),
      aiu: median(set.map((run) => run.nanoAiu)),
    }
  })
const roundTwoBaseline = roundTwoSetups[0]
const roundTwoBestTokens = roundTwoSetups.reduce((best, setup) => setup.tokens < best.tokens ? setup : best)
const roundTwoBestAiu = roundTwoSetups.reduce((best, setup) => setup.aiu < best.aiu ? setup : best)
const roundTwoDelta = (setup: (typeof roundTwoSetups)[number]) => {
  const delta = setup.tokens / roundTwoBaseline.tokens - 1
  return delta === 0 ? '0%' : `${delta > 0 ? '+' : '−'}${percent.format(Math.abs(delta))}`
}
const roundTwoFailed = roundTwoRuns.filter((run) => !run.success)
const roundTwoSpread = roundTwoSetups.map((setup) => setup.high - setup.low)
const roundTwoCallAxis = Math.ceil(
  Math.max(...roundTwoSetups.flatMap((setup) => setup.shown.calls.map(total))) / 10_000,
) * 10_000
const roundTwoStripMax = Math.ceil(
  Math.max(...roundTwoRuns.map((run) => total(run.totals))) / 100_000,
) * 100_000
const roundTwoStripTicks = [0, 1, 2, 3].map((i) => (roundTwoStripMax / 3) * i)
const roundTwoRates = roundTwoData.rates as Tokens
const roundTwoRateList = kinds
  .map((kind) => `${names[kind].toLowerCase()} ${perThousand.format(roundTwoRates[kind] / 1e6)}`)
  .join(', ')
const roundTwoHasOptimizer = roundTwoSetups.some((setup) => setup.id === 'f')
const roundTwoVersions = roundTwoData.versions as Record<string, string>

const description =
  `Two bug-fix tasks, ${number.format(runs.length + roundTwoRuns.length)} coding-agent runs. Compare token use and Copilot AIU across simple instructions, hooks, output filters, and a longer regression hunt.`
---

<SiteLayout title="Coding Agent Token Diet: Before and After" description={description}>
  <Fragment slot="heading">Does Your Coding Agent Need a Token Diet?</Fragment>
  <div class="diet">
    <dl class="lede">
      <dt>Claim</dt>
      <dd>
        Do simple principles, caveman, rtk{optimizer ? ', or Token Optimizer' : ''} make a coding agent use fewer tokens?
      </dd>
      <dt>Result</dt>
      <dd>
        <strong>One task, five runs per setup.</strong> Median token use ranged from {change(closest)}
        ({closest.name}) to {change(furthest)} ({furthest.name}), versus the plain agent (baseline).
      </dd>
      <dt>Why</dt>
      <dd>{tokenShare('cacheRead')} of tokens were conversation history re-read on each call.</dd>
    </dl>

    <div class="tabs">
    <input type="radio" name="section" id="tab-calls" checked />
    <label for="tab-calls">Waterfall</label>
    <section class="race" aria-labelledby="race-title">
      <h2 id="race-title">Before and after, call by call</h2>
      <div class="controls">
        <fieldset>
          <legend class="visually-hidden">Compare the baseline with</legend>
          <span class="muted" aria-hidden="true">Baseline vs</span>
          {after.map((setup) => (
            <label>
              <input type="radio" name="after" id={`after-${setup.id}`} value={setup.id} checked={setup.id === 'e'} />
              {setup.name}
            </label>
          ))}
        </fieldset>
        <button type="button" class="replay">Replay</button>
      </div>

      <figure>
        <div class="panels">
          {setups.map((setup) => {
            const run = setup.shown
            const size = total(run.totals)
            const value = (meter: string, text: string) => (
              <span data-meter={meter} style={`--chars:${text.length}`}>{text}</span>
            )
            return (
              <div class="panel" data-lane={setup.id}>
                <p class="pill">
                  {setup.name}
                  <span aria-hidden="true">{value('tokens', number.format(size))} tokens</span>
                  {setup !== baseline && <span class:list={['change', versus(setup) > 0 ? 'worse' : 'better']}>{change(setup)}<span class="visually-hidden"> vs baseline</span></span>}
                  <span class="visually-hidden">
                    , run {run.id}: {number.format(size)} tokens, {run.calls.length} model calls, {aiu(run.nanoAiu)} AIU
                  </span>
                </p>
                <ol class="waterfall" style={`--divisions:${callAxis / 10_000};--rows:${run.calls.length}`}>
                  {run.calls.map((call, i) => (
                    <li>
                      <span aria-hidden="true">{i + 1}</span>
                      <span class="what" title={what(call)}>{what(call)}</span>
                      <span class="track" aria-hidden="true">
                        <span class="bar" style={`--w:${pct(total(call), callAxis)}`}>
                          {kinds.map((kind) => <span class={kind} style={`flex-grow:${call[kind]}`} />)}
                        </span>
                      </span>
                      <span>{thousands(total(call))}<span class="visually-hidden"> tokens</span></span>
                    </li>
                  ))}
                </ol>
                <div class="summary" aria-hidden="true">
                  <div class="rings">
                    <span class="ring ring-tokens" style={stops(kinds.map((kind) => run.totals[kind]))} />
                    <span class="ring ring-cost" style={stops(kinds.map((kind) => run.totals[kind] * rates[kind]))} />
                    <span class="ring-total">{value('center', thousands(size))}tokens</span>
                  </div>
                  <table>
                    <thead>
                      <tr><th /><th>Tokens</th><th>AIU</th></tr>
                    </thead>
                    <tbody>
                      {kinds.map((kind) => (
                        <tr>
                          <th><span class:list={['swatch', kind]} />{names[kind]}</th>
                          <td>{value(kind, number.format(run.totals[kind]))}</td>
                          <td>{value(`${kind}-aiu`, aiu(run.totals[kind] * rates[kind]))}</td>
                        </tr>
                      ))}
                    </tbody>
                    <tfoot>
                      <tr>
                        <th>Total</th>
                        <td>{value('total', number.format(size))}</td>
                        <td>{value('AIU', aiu(run.nanoAiu))}</td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              </div>
            )
          })}
        </div>

        <figcaption>
          One row per model call; gridlines every 10k tokens. Grey is the conversation so far, re-read on every call.
        </figcaption>
      </figure>
      <script is:inline type="application/json" id="race-data" set:html={raceJson} />
    </section>

    <input type="radio" name="section" id="tab-tokens" />
    <label for="tab-tokens">Tokens</label>
    <section class="tokenizer" aria-labelledby="tokens-title">
      <h2 id="tokens-title">What the agent reads first, in tokens</h2>
      <div class="intro-row">
        <p>
          The task prompt every run starts with, and the six instructions the principles setup adds, split into tokens:
        </p>
        <fieldset class="views">
          <legend class="visually-hidden">Show</legend>
          <label><input type="radio" name="token-view" id="token-text" checked /> Text</label>
          <label><input type="radio" name="token-view" id="token-ids" /> Token IDs</label>
        </fieldset>
      </div>
      <div class="readings">
        {readings.map((reading) => (
          <div class="reading">
            <p class="kicker">
              {reading.label} <span class="count">{number.format(reading.tokens)} tokens</span>
              <span class="muted">· {number.format(reading.characters)} characters</span>
            </p>
            {reading.parts.map((part, i) => i && part === prompt ? (
              <p class="part">+ {part.name} <span class="muted">· {part.ids.length} tokens, same as baseline</span></p>
            ) : (
              <>
                <p class="part">{part.name} <span class="muted">· {part.ids.length} tokens</span></p>
                <p class="token-text">{part.pieces.map((piece) => <span>{piece}</span>)}</p>
                <p class="token-ids">[{part.ids.join(', ')}]</p>
              </>
            ))}
          </div>
        ))}
        <p class="note">
          Split with OpenAI’s o200k_base, an illustration: Claude’s tokenizer isn’t public. Measured, the principles
          added a median {number.format(principles.prompt - baseline.prompt)} first-call tokens (the file plus the CLI’s
          wrapper). The runs didn’t record the system prompt, {number.format(data.toolDefinitionsTokens)} tokens of tool
          definitions, the skill list, or the setup hooks and tools.
        </p>
      </div>
    </section>

    <input type="radio" name="section" id="tab-runs" />
    <label for="tab-runs">Every run</label>
    <section aria-labelledby="runs-title">
      <h2 id="runs-title">Every run</h2>
      <figure class="strip">
        <div class="strip-rows" aria-hidden="true">
          {setups.map((setup) => (
            <div class="strip-row">
              <span>{setup.name}</span>
              <div class="strip-track">
                <span class="median" style={`--x:${pct(setup.tokens, stripMax)}`} />
                {setup.set.map((run) => (
                  <span class:list={['dot', { failed: !run.success }]} style={`--x:${pct(total(run.totals), stripMax)}`} />
                ))}
              </div>
            </div>
          ))}
          <div class="strip-row">
            <span />
            <div class="axis">
              {stripTicks.map((tick) => <span style={`--x:${pct(tick, stripMax)}`}>{tick ? thousands(tick) : '0'}</span>)}
            </div>
          </div>
        </div>
        <figcaption>
          Total tokens per run. Each dot is a run;{failed.length ? ' hollow dots are failed runs;' : ''} the line marks the median.
        </figcaption>
      </figure>

      <div class="table-wrap">
        <table>
          <caption>
            Medians over five runs{failed.length ? ', failed runs included' : ''}. First-call prompt: all the agent sends before acting —
            system prompt, {number.format(data.toolDefinitionsTokens)} tokens of tool definitions, instructions, skills, task.
          </caption>
          <thead>
            <tr>
              <th scope="col">Setup</th>
              <th scope="col">Succeeded</th>
              <th scope="col">Median tokens</th>
              <th scope="col">Range</th>
              <th scope="col">Calls</th>
              <th scope="col">AIU</th>
              <th scope="col">First-call prompt</th>
            </tr>
          </thead>
          <tbody>
            {setups.map((setup) => (
              <tr>
                <th scope="row">{setup.name}</th>
                <td>{setup.succeeded}/{setup.set.length}</td>
                <td>{number.format(setup.tokens)}</td>
                <td>{thousands(setup.low)}–{thousands(setup.high)}</td>
                <td>{setup.calls}</td>
                <td>{aiu(setup.aiu)}</td>
                <td>
                  {number.format(setup.prompt)}
                  {setup !== baseline && <span class="muted"> ({signed(setup.prompt - baseline.prompt)})</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <input type="radio" name="section" id="tab-findings" />
    <label for="tab-findings">Findings</label>
    <section aria-labelledby="findings-title">
      <h2 id="findings-title">What the runs show</h2>
      <div class="tabs side">
        <input type="radio" name="finding" id="finding-1" checked />
        <label for="finding-1">{beatBaseline.length ? `${beatBaseline.length} of ${after.length} setups beat the baseline` : 'No setup beat the baseline'}</label>
        <p>
        The baseline’s median run used {number.format(baseline.tokens)}
        tokens. The medians for {after.map((setup) => setup.name.toLowerCase()).join(', ')} were
        {' '}{after.map((setup) => number.format(setup.tokens)).join(', ')}.
        {failed.length
          ? `${failed.length === 1 ? 'One run' : `${failed.length} runs`} of ${runs.length} failed: ${failed.map((run) => `${run.id} (${nameOf(run)}) ${why(run)}`).join('; ')}.`
          : `All ${runs.length} runs succeeded.`}
        </p>
        <input type="radio" name="finding" id="finding-2" />
        <label for="finding-2">Five runs are exploratory</label>
        <p>
        The narrowest within-setup range was {number.format(narrowestSpread)} tokens, while the widest gap between two
        setups’ medians was {number.format(widestGap)}. With one task and five runs per setup, treat these results as
        exploratory rather than conclusive. The single largest run,
        {' '}{largest.id} ({nameOf(largest)}), used {number.format(total(largest.totals))} tokens over
        {' '}{largest.calls.length} calls.
        </p>
        <input type="radio" name="finding" id="finding-3" />
        <label for="finding-3">Calls drove tokens</label>
        <p>
        Across all {runs.length} runs, total tokens tracked the number of model calls
        (Pearson r = {callsVsTokens.toFixed(2)}). Every call re-reads the whole conversation so far, so calls grow
        as a run goes on: the last call of a run processed a median {number.format(lastCall)} tokens.
        </p>
        <input type="radio" name="finding" id="finding-4" />
        <label for="finding-4">Tokens aren’t the bill</label>
        <p>
        Cache reads were {tokenShare('cacheRead')} of all tokens but
        {' '}{costShare('cacheRead')} of the AIU. Cache writes were {tokenShare('cacheWrite')} of tokens and
        {' '}{costShare('cacheWrite')} of AIU; output was {tokenShare('output')} of tokens and {costShare('output')}
        of AIU.
        {mixed
          ? `So the two can disagree: ${mixed.name}’s median was ${side(mixed.tokens, baseline.tokens)} the baseline’s in tokens (${number.format(mixed.tokens)} against ${number.format(baseline.tokens)}) but ${side(mixed.aiu, baseline.aiu)} it in AIU (${aiu(mixed.aiu)} against ${aiu(baseline.aiu)}).`
          : 'On this task, every setup’s tokens and AIU moved in the same direction against the baseline.'}
        </p>
        <input type="radio" name="finding" id="finding-5" />
        <label for="finding-5">Principles added little</label>
        <p>
        The six rules added
        {' '}{number.format(principles.prompt - baseline.prompt)} tokens to the prompt. Their runs took a median of
        {' '}{principles.calls} calls against the baseline’s {baseline.calls}.
        </p>
        <input type="radio" name="finding" id="finding-6" />
        <label for="finding-6">caveman added context</label>
        <p>
        Installing it added
        {' '}{number.format(caveman.prompt - baseline.prompt)} tokens to the first prompt — a
        {' '}{number.format(caveman.set[0].hookChars)}-character session-start instruction and {extraSkills} more
        skills in the skill list. Writing them to the cache made its first call cost {aiu(caveman.firstAiu)} AIU
        against the baseline’s {aiu(baseline.firstAiu)}, and every later call re-reads them. Median prose per run went from
        {' '}{number.format(baseline.prose)} to {number.format(caveman.prose)} characters. Prose is the small part
        anyway: {wholePercent.format(1 - baseline.proseShare)} of what the baseline agent wrote was tool input, such
        as commands and edits.
        </p>
        <input type="radio" name="finding" id="finding-7" />
        <label for="finding-7">The agent already did rtk’s job</label>
        <p>
        A plain run of the failing suite prints
        {' '}{number.format(data.fixture.outputLines)} lines. The agent ran the suite {testRuns} times across the
        {' '}{runs.length} runs; {testRuns - unpipedTestRuns} test invocations piped output through a filter such as
        {' '}<code>tail</code> or <code>grep</code>. The largest single tool result was smaller with rtk
        ({number.format(rtk.biggestResult)} tokens, against
        {' '}{number.format(baseline.biggestResult)} at baseline), and rtk reported a median
        {' '}{number.format(rtkSaved)} tokens saved per run — its own estimate, and less than a single late call
        processes. Its instruction and hook added {number.format(rtk.prompt - baseline.prompt)} tokens to the prompt.
        </p>
        <input type="radio" name="finding" id="finding-8" />
        <label for="finding-8">Combining the three setups</label>
        <p>
        All three together added {number.format(all.prompt - baseline.prompt)} tokens to the prompt,
        made the first call cost {aiu(all.firstAiu)} AIU and had median total cost {aiu(all.aiu)} AIU.
        </p>
