Date.now().toString(36) + Math.random().toString(36).slice(2);\n\n  function render() {\n    const f = filter();\n    const visible = todos.filter(t => f === 'active' ? !t.done : f === 'completed' ? t.done : true);\n    list.innerHTML = '';\n    for (const t of visible) {\n      const li = document.createElement('li');\n      li.dataset.id = t.id;\n      if (t.done) li.classList.add('completed');\n      const cb = document.createElement('input');\n      cb.type = 'checkbox'; cb.className = 'toggle'; cb.checked = t.done;\n      cb.setAttribute('aria-label', 'Toggle ' + t.title);\n      const label = document.createElement('label');\n      label.textContent = t.title;\n      const del = document.createElement('button');\n      del.className = 'destroy'; del.textContent = '×';\n      del.setAttribute('aria-label', 'Delete ' + t.title);\n      li.append(cb, label, del);\n      list.append(li);\n    }\n    const active = todos.filter(t => !t.done).length;\n    count.textContent = `${active} item${active === 1 ? '' : 's'} left`;\n    footer.classList.toggle('hidden', todos.length === 0);\n    toggleAll.classList.toggle('hidden', todos.length === 0);\n    toggleAll.classList.toggle('on', todos.length > 0 && active === 0);\n    clearBtn.classList.toggle('hidden', todos.length === active);\n    document.querySelectorAll('.filters a').forEach(a =>\n      a.classList.toggle('selected', a.getAttribute('href') === '#/' + (f === 'all' ? '' : f)));\n    save();\n  }\n\n  const find = el => todos.find(t => t.id === el.closest('li').dataset.id);\n\n  input.addEventListener('keydown', e => {\n    if (e.key !== 'Enter') return;\n    const title = input.value.trim();\n    if (!title) return;\n    todos.push({ id: uid(), title, done: false });\n    input.value = '';\n    render();\n  });\n\n  list.addEventListener('change', e => {\n    if (!e.target.classList.contains('toggle')) return;\n    find(e.target).done = e.target.checked;\n    render();\n  });\n\n  list.addEventListener('click', e => {\n    if (!e.target.classList.contains('destroy')) return;\n    const t = find(e.target);\n    todos = todos.filter(x => x !== t);\n    render();\n  });\n\n  list.addEventListener('dblclick', e => {\n    if (e.target.tagName !== 'LABEL') return;\n    const li = e.target.closest('li'), t = find(li);\n    const edit = document.createElement('input');\n    edit.className = 'edit'; edit.value = t.title;\n    li.replaceChildren(edit);\n    edit.focus();\n    let done = false;\n    const finish = commit => {\n      if (done) return; done = true;\n      if (commit) {\n        const v = edit.value.trim();\n        if (v) t.title = v; else todos = todos.filter(x => x !== t);\n      }\n      render();\n    };\n    edit.addEventListener('keydown', ev => {\n      if (ev.key === 'Enter') finish(true);\n      else if (ev.key === 'Escape') finish(false);\n    });\n    edit.addEventListener('blur', () => finish(true));\n  });\n\n  toggleAll.addEventListener('click', () => {\n    const all = todos.every(t => t.done);\n    todos.forEach(t => t.done = !all);\n    render();\n  });\n\n  clearBtn.addEventListener('click', () => {\n    todos = todos.filter(t => !t.done);\n    render();\n  });\n\n  window.addEventListener('hashchange', render);\n  render();\n})();\n</script>\n</body>\n</html>\n"},"type":"function","intentionSummary":"create a new file at /workspace/todomvc/index.html.","toolTitle":"Creating file"}],"interactionId":"6595cb8a-4d29-429f-bc2b-7b83ed31c352","turnId":"0"}}
