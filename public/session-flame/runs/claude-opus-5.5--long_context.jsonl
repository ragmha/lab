 done: false });\n+    input.value = '';\n+    render();\n+  });\n+\n+  list.addEventListener('change', e => {\n+    if (!e.target.classList.contains('toggle')) return;\n+    find(e.target).done = e.target.checked;\n+    render();\n+  });\n+\n+  list.addEventListener('click', e => {\n+    if (!e.target.classList.contains('destroy')) return;\n+    const t = find(e.target);\n+    todos = todos.filter(x => x !== t);\n+    render();\n+  });\n+\n+  list.addEventListener('dblclick', e => {\n+    if (e.target.tagName !== 'LABEL') return;\n+    const li = e.target.closest('li'), t = find(li);\n+    const edit = document.createElement('input');\n+    edit.className = 'edit'; edit.value = t.title;\n+    li.replaceChildren(edit);\n+    edit.focus();\n+    let done = false;\n+    const finish = commit => {\n+      if (done) return; done = true;\n+      if (commit) {\n+        const v = edit.value.trim();\n+        if (v) t.title = v; else todos = todos.filter(x => x !== t);\n+      }\n+      render();\n+    };\n+    edit.addEventListener('keydown', ev => {\n+      if (ev.key === 'Enter') finish(true);\n+      else if (ev.key === 'Escape') finish(false);\n+    });\n+    edit.addEventListener('blur', () => finish(true));\n+  });\n+\n+  toggleAll.addEventListener('click', () => {\n+    const all = todos.every(t => t.done);\n+    todos.forEach(t => t.done = !all);\n+    render();\n+  });\n+\n+  clearBtn.addEventListener('click', () => {\n+    todos = todos.filter(t => !t.done);\n+    render();\n+  });\n+\n+  window.addEventListener('hashchange', render);\n+  render();\n+})();\n+</script>\n+</body>\n+</html>\n"},"turnId":"0","interactionId":"6595cb8a-4d29-429f-bc2b-7b83ed31c352"}}
