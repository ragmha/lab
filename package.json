{
  "name": "raghib-lab",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @lab/site dev",
    "build": "bun run --filter @lab/site build",
    "test": "bun run --filter '*' test",
    "test:browser": "bun run --filter @lab/site test:browser"
  },
  "packageManager": "bun@1.3.5"
}
