---
import '../styles/global.css'
import SeoHead from '../components/SeoHead.astro'
import ThemeInit from '../components/ThemeInit.astro'
import inventory from '../data/content-links.json'

interface Props {
  title?: string
  description?: string
  bodyClass?: string
  pageClass?: string
  defaultTheme?: 'dark' | 'system'
}

const {
  title,
  description,
  bodyClass,
  pageClass,
  defaultTheme,
} = Astro.props
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '')
const entry: { slug: string; writing?: string } | undefined = inventory.labs.find((lab) => lab.slug === slug)

---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} />
    {defaultTheme && <ThemeInit defaultTheme={defaultTheme} />}
  </head>
  <body class={bodyClass}>
    <div class:list={['page', pageClass]}>
      <slot />
      {entry?.writing && (
        <aside class="related-writing" aria-label="Related writing">
          <a href={`https://raghib.io/writing/${entry.writing}/`}>Read the related writing</a>
        </aside>
      )}
    </div>
    <script>
      import '../scripts/copy-code'
    </script>
  </body>
</html>

<style>
  .related-writing { margin-top: 2rem; padding-block: 1rem; font-size: 0.9rem; }
</style>
